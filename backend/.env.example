PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5434/corporacao_db?schema=public"
JWT_SECRET="your_secret_key_here"
NODE_ENV=development

# Segurança de recuperação de senha
# Em produção, mantenha false até configurar fluxo seguro (e-mail/SMTP + governança)
PASSWORD_RECOVERY_ENABLED=false

# Nunca habilitar em produção. Apenas debug local controlado.
EXPOSE_RECOVERY_TOKEN_IN_RESPONSE=false

# Neon PostgreSQL (Production)
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
