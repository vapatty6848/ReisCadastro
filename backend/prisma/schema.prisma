generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

model Responsavel {
  id          String       @id @default(uuid())
  nome        String
  cpf         String       @unique
  telefone    String
  email       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bairro      String?
  cep         String?
  numero      String?
  parentesco  String?
  rua         String?
  integrantes Integrante[]

  @@index([id])
}

model Corporacao {
  id              String       @id @default(uuid())
  nome            String       @unique
  rua             String?
  numero          String?
  bairro          String?
  cep             String?
  telefone        String?
  email           String?
  cidade          String?
  estado          String?
  contatoNome     String?
  contatoTelefone String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  integrantes     Integrante[]
  isPredefinida   Boolean      @default(false)
}

model Integrante {
  id                     String             @id @default(uuid())
  nome                   String
  dataNascimento         DateTime
  documento              String
  documentoTipo          DocumentoTipo      @default(CPF)
  telefone               String
  email                  String?
  fotos                  String[]
  rua                    String?
  numero                 String?
  complemento            String?
  bairro                 String?
  cep                    String?
  dataMatricula          DateTime
  matriculaNumero        String?            @unique
  tipoIntegrante         TipoIntegrante
  subtipoIntegrante      SubtipoIntegrante?
  tamanhoUniforme        String?
  tamanhoBota            String?
  instrumento            String?
  instrumentoOrigem      OrigemInstrumento?
  instrumentoRecebimento DateTime?
  instrumentoDevolucao   DateTime?
  observacoes            String?
  responsavelId          String?
  corporacaoId           String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  patrimonio             String?
  fotoPerfil             String?
  corporacao             Corporacao         @relation(fields: [corporacaoId], references: [id])
  responsavel            Responsavel?       @relation(fields: [responsavelId], references: [id])

  @@index([documento])
  @@index([matriculaNumero])
  @@index([corporacaoId])
}

enum TipoIntegrante {
  CORPO_MUSICAL
  LINHA_FRENTE
  APOIO
}

enum SubtipoIntegrante {
  INSTRUMENTOS
  INSTRUMENTOS_ROTATIVOS
  COMANDANTE_MOR
  PAVILHAO_NACIONAL
  CORPO_COREOGRAFICO
  BALIZAS
}

enum OrigemInstrumento {
  PROJETO
  EMPRESA
}

enum DocumentoTipo {
  CPF
  CIN
}
